{
  "name": "ab-nextjs-theme",
  "version": "0.3.7",
  "description": "🎨 A lightweight collection of client React components as theme abElements created by Abraham Ukachi, and optimized for Next.js applications 😎.",
  "type": "module",
  "main": "index.ts",
  "types": "types/index.d.ts",
  "files": [
    "index.ts",
    "index.css",
    "styles.css",
    "colors.ts",
    "colors.js",
    "typography.ts",
    "typography.js",
    "material-theme.json",
    "css",
    "types",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "homepage": "https://github.com/abraham-ukachi/ab-nextjs-theme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abraham-ukachi/ab-nextjs-theme.git"
  },
  "bugs": {
    "url": "https://github.com/abraham-ukachi/ab-nextjs-theme/issues"
  },
  "scripts": {
    "lint": "pnpm lint:ts && pnpm lint:css",
    "lint:ts": "eslint . --fix",
    "lint:css": "stylelint \"**/*.css\" --max-warnings 0 --fix",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "check:publish": "node scripts/check-publish-deps.mjs && node scripts/check-css-assets.mjs",
    "prepack": "node scripts/check-publish-deps.mjs && node scripts/check-css-assets.mjs",
    "prepublishOnly": "node scripts/check-publish-deps.mjs && node scripts/check-css-assets.mjs"
  },
  "keywords": [
    "react",
    "nextjs",
    "theme",
    "abraham",
    "ukachi",
    "ab-nextjs-theme",
    "ab-elements"
  ],
  "author": {
    "name": "Abraham Ukachi",
    "url": "https://github.com/abraham-ukachi",
    "email": "abrahamukachi@gmail.com"
  },
  "license": "MIT",
  "peerDependencies": {
    "next": "^16.3.4",
    "react": "^19",
    "react-dom": "^19",
    "ab-nextjs-fonts": "^0.2.6",
    "ab-nextjs-animations": "^0.2.1",
    "ab-nextjs-icons": "^0.2.4"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "ab-nextjs-fonts": {
      "optional": true
    },
    "ab-nextjs-animations": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20",
    "ab-nextjs-animations": "^0.2.1",
    "ab-nextjs-fonts": "^0.2.6",
    "ab-nextjs-icons": "^0.2.4",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.4",
    "next": "16.3.4",
    "react": "^19",
    "react-dom": "^19",
    "stylelint": "^16.24.0",
    "stylelint-config-css-modules": "^4.5.1",
    "stylelint-config-standard": "^39.0.0",
    "typescript": "^5",
    "vitest": "^3"
  }
}
